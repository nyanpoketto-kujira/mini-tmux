DISCORD_TOKEN=your_discord_bot_token_here

# --- ADMIN GUARD (opsional) ---
# ADMIN_MODE=true mengaktifkan blacklist perintah berbahaya (rm -rf, sudo,
# shutdown/reboot, dsb.): perintah diblokir sampai disetujui admin lewat
# tombol. Status bisa di-toggle dari Discord dengan "safe!on" / "safe!off".
# ADMIN_ROLE_ID = ID role Discord yang boleh menekan tombol & toggle.
ADMIN_MODE=false
ADMIN_ROLE_ID=000000000000000000